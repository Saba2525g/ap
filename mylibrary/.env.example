# ==== Flask ====
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-generate-with-secrets-token_urlsafe-48

# ==== Database ====
# For SQLite (development default):
DATABASE_URL=sqlite:///mylibrary-dev.db
# For MySQL (production), uncomment and configure:
# DATABASE_URL=mysql+pymysql://mylib_user:YOUR_PASSWORD@localhost:3306/mylibrary?charset=utf8mb4

# ==== Testing ====
TEST_DATABASE_URL=sqlite:///mylibrary-test.db

# ==== Security ====
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
WTF_CSRF_TIME_LIMIT=3600

# ==== Rate limiting ====
RATELIMIT_STORAGE_URI=memory://

# ==== Library defaults ====
DEFAULT_LOAN_DAYS=14
MAX_ACTIVE_LOANS=5
FINE_PER_DAY=5000
